# Copy this file to backend/.env and fill in real values. backend/.env is git-ignored.

# --- Database (MySQL 8.x) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hostel_management_db
DB_USERNAME=root
DB_PASSWORD=change-me
# Separate schema used by automated integration tests (dropped/recreated by tests)
TEST_DB_NAME=hostel_management_test

# --- Security ---
# At least 32 random characters. Generate e.g. with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
REFRESH_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

# --- Application ---
# REQUIRED: dev (demo data, local use) or prod. The application refuses to start without an explicit profile.
SPRING_PROFILES_ACTIVE=dev
# prod only: framework when behind a trusted TLS reverse proxy (so rate limits and audit IPs see real client IPs), else none
FORWARD_HEADERS_STRATEGY=none
SERVER_PORT=8080
APP_TIME_ZONE=Asia/Kolkata
UPLOAD_DIR=./data/uploads
DEV_SEED_ENABLED=true

# --- WhatsApp ---
# MOCK = simulated messages only (nothing is sent). META = WhatsApp Business Cloud API.
WHATSAPP_MODE=MOCK
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# --- Online payments ---
# mock     = simulated checkout, no real money (default; refused under the prod profile)
# razorpay = Razorpay. Use Test Mode keys (rzp_test_...) in development; rzp_live_ keys are refused outside prod.
# Switching providers is a config change plus an adapter; see docs/PAYMENTS.md.
PAYMENT_PROVIDER=mock
# Smallest allowed partial payment in INR (paying the full remaining balance is always allowed)
PAYMENT_MIN_PARTIAL_AMOUNT=100
# How long a resident pay link stays valid
PAYMENT_LINK_EXPIRY_DAYS=7
# Razorpay Dashboard (Test Mode) > Account & Settings > API Keys. Never commit real values; this file is only a template.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Account & Settings > Webhooks > add https://<public-host>/api/payments/webhook/razorpay, choose a secret,
# subscribe to payment.captured, payment.failed, order.paid. Required only for webhook delivery.
RAZORPAY_WEBHOOK_SECRET=

# --- Platform super admin ---
# Created on start-up when no SUPER_ADMIN exists (never overwrites an existing account). Leave empty to skip.
# The dev profile falls back to superadmin@hostelhub.dev / Admin@12345 when these are unset.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# --- E-mail (password reset) ---
# LOG      = write the e-mail text to the server log, send nothing (development default; refused under the prod profile)
# SMTP     = send through any SMTP server (Gmail app password, Brevo, SES SMTP, Mailgun, your own host ...)
# DISABLED = send nothing and say nothing (password-reset still answers generically)
# Never commit real credentials. See docs/EMAIL.md.
MAIL_MODE=LOG
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=HostelHub
# NONE | STARTTLS | SSL  (587 usually STARTTLS, 465 usually SSL)
MAIL_TLS=STARTTLS
MAIL_AUTH=true

# --- Automatic rent reminders ---
# Master switch for the daily job. Each owner must also turn it on in Settings, and residents must have agreed to WhatsApp.
# WhatsApp itself stays in MOCK mode (messages are only recorded as SIMULATED) until WHATSAPP_MODE=META is configured.
RENT_REMINDERS_ENABLED=true
RENT_REMINDERS_CRON=0 0 9 * * *

# --- Encryption of bank account numbers ---
# Base64 of 32 random bytes. Generate with:  openssl rand -base64 32
# Required in prod to store owners' bank details. If you lose or change it, saved account numbers cannot be read and must be re-entered.
DATA_ENCRYPTION_KEY=
